{
  "operators":[
    {
      "type":"scan",
      "table":"orders"
    },
    {
      "type":"aggregate",
      "group_by":[
        "category",
        "product"
      ],
      "metric":"sum(payment)"
    },
    {
      "type":"window_rank",
      "partition_by":[
        "category"
      ],
      "order_by":"revenue desc"
    },
    {
      "type":"filter",
      "condition":"rank<=3"
    }
  ]
}